&quot;margin:0 0 24px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;color:#5f6b7a;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;line-height:1.5;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;label{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;display:block;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;margin:16px 0 7px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-weight:700;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;input{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;width:100%;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;padding:13px 14px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:1px solid #cbd5e1;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border-radius:8px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-size:16px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;outline:none;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;input:focus{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border-color:#168b46;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;box-shadow:0 0 0 3px rgba(22,139,70,.12);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;width:100%;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;margin-top:24px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;padding:14px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:0;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border-radius:8px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;background:#168b46;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;color:#ffffff;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-size:16px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-weight:700;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;cursor:pointer;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button:hover{background:#11743a;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button:disabled{background:#94a3b8;cursor:not-allowed;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;#statusBox{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;display:none;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;margin-top:22px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;padding:14px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border-radius:8px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;line-height:1.5;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;word-break:break-word;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.processing{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;display:block!important;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;background:#fff7d6;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:1px solid #e4c754;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;color:#6b5600;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.success{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;display:block!important;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;background:#dcfce7;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:1px solid #4ade80;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;color:#166534;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.error{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;display:block!important;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;background:#fee2e2;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:1px solid #f87171;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;color:#991b1b;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/style>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/head>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;body>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;main class='card'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;h1>Solicitud de enmascaramiento&lt;/h1>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;p class='description'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;Ingrese el RUT del cliente. Talend ejecutará la Task de enmascaramiento &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;y consultará automáticamente el estado del proceso.&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/p>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;form id='maskForm'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;label for='rut'>RUT del cliente&lt;/label>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;input &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;id='rut' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;name='rut' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;type='text' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;placeholder='10000014-4' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;required>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;label for='usuario'>Usuario solicitante&lt;/label>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;input &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;id='usuario' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;name='usuario' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;type='text' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;value='arleth.caceres' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;required>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;button id='submitButton' type='submit'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;Enmascarar datos&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/button>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/form>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;div id='statusBox'>&lt;/div>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/main>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;script>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const form=document.getElementById('maskForm');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const button=document.getElementById('submitButton');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const statusBox=document.getElementById('statusBox');&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;let basePath=window.location.pathname;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(basePath.endsWith('/ui/')){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;basePath=basePath.slice(0,-4);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}else if(basePath.endsWith('/ui')){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;basePath=basePath.slice(0,-3);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const POLL_MS=&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ (context.poll_interval_seconds * 1000)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;;&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const MAX_ATTEMPTS=&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ context.poll_max_attempts&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;;&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;function showStatus(message,type){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;statusBox.className=type;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;statusBox.textContent=message;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;function sleep(milliseconds){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return new Promise(function(resolve){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;setTimeout(resolve,milliseconds);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;async function consultStatus(executionId){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;for(let attempt=1;attempt&lt;=MAX_ATTEMPTS;attempt++){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;await sleep(POLL_MS);&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const response=await fetch(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;basePath+'/status/'+encodeURIComponent(executionId)&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const data=await response.json();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!response.ok){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;data.message||'No fue posible consultar el estado.'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(data.status==='MASK_COMPLETED'){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'Enmascaramiento completado correctamente. ID de ejecución: '+executionId,&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'success'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(data.status==='MASK_FAILED'){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;(data.message||'El enmascaramiento terminó con error.')&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;+(data.errorMessage?' Detalle: '+data.errorMessage:''),&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'error'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(data.status==='STATUS_UNKNOWN'){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'No fue posible determinar el estado de la ejecución.',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'error'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'Procesando solicitud. Consulta '+attempt+' de '+MAX_ATTEMPTS+'.',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'processing'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'La ejecución continúa activa, pero se alcanzó el límite de consultas. &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;ID de ejecución: '+executionId,&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'processing'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;form.addEventListener('submit',async function(event){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;event.preventDefault();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const rut=document.getElementById('rut').value.trim();&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const usuario=document.getElementById('usuario').value.trim();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!/^[0-9]{7,8}-[0-9Kk]$/.test(rut)){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Ingrese un RUT con formato válido.','error');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!usuario){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Ingrese el usuario solicitante.','error');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.disabled=true;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.textContent='Procesando...';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Enviando solicitud a Talend Cloud...','processing');&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;try{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const response=await fetch(basePath+'/mask',{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;method:'POST',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;headers:{'Content-Type':'application/json'},&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;body:JSON.stringify({&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;rut_solicitud:rut,&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;usuario_solicitante:usuario&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;})&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const data=await response.json();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!response.ok){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;data.message||'No fue posible iniciar el enmascaramiento.'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!data.executionId){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'La respuesta no contiene el identificador de ejecución.'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'La ejecución fue iniciada. ID: '+data.executionId,&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'processing'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;);&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;await consultStatus(data.executionId);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}catch(error){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(error.message||'Ocurrió un error inesperado.','error');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}finally{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.disabled=false;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.textContent='Enmascarar datos';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/script>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/body>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/html>&quot; " type="id_String" nullable="true"/>
