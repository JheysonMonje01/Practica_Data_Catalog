    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="context.rut_solicitud = input_row.rut;&#xD;&#xA;&#xD;&#xA;String ip = &quot;desconocida&quot;;&#xD;&#xA;try {&#xD;&#xA;    org.apache.cxf.message.Message cxfMsg = org.apache.cxf.phase.PhaseInterceptorChain.getCurrentMessage();&#xD;&#xA;    if (cxfMsg != null) {&#xD;&#xA;        Object req = cxfMsg.get(&quot;HTTP.REQUEST&quot;);&#xD;&#xA;        if (req != null) {&#xD;&#xA;            java.lang.reflect.Method getHeader = req.getClass().getMethod(&quot;getHeader&quot;, String.class);&#xD;&#xA;            Object xff = getHeader.invoke(req, &quot;X-Forwarded-For&quot;);&#xD;&#xA;            if (xff != null &amp;&amp; !xff.toString().isEmpty()) {&#xD;&#xA;                ip = xff.toString().split(&quot;,&quot;)[0].trim();&#xD;&#xA;            } else {&#xD;&#xA;                java.lang.reflect.Method getRemoteAddr = req.getClass().getMethod(&quot;getRemoteAddr&quot;);&#xD;&#xA;                ip = (String)getRemoteAddr.invoke(req);&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;} catch (Exception e) {&#xD;&#xA;    ip = &quot;desconocida&quot;;&#xD;&#xA;}&#xD;&#xA;globalMap.put(&quot;ip_origen&quot;, ip);&#xD;&#xA;System.out.println(&quot;>>> IP ORIGEN: &quot; + ip);"/>
