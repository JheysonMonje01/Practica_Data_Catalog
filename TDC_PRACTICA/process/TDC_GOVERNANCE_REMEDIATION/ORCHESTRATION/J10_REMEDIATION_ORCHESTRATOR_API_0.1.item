        <mapperTableEntries name="body" expression="&quot;&lt;!DOCTYPE html>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;html lang='es'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;head>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;meta charset='UTF-8'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;meta name='viewport' content='width=device-width, initial-scale=1.0'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;title>Remediación de datos&lt;/title>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;style>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;*{box-sizing:border-box;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;body{margin:0;padding:20px;font-family:Arial,sans-serif;background:#f4f6f8;color:#172033;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.card{max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:24px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;box-shadow:0 4px 18px rgba(0,0,0,.12);}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;h2{margin:0 0 8px;color:#14213d;font-size:22px;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.description{margin:0 0 22px;color:#5b6475;font-size:14px;line-height:1.5;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;label{display:block;margin-bottom:7px;font-weight:bold;font-size:14px;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;input{width:100%;padding:12px;border:1px solid #c8ced8;border-radius:7px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-size:16px;text-transform:uppercase;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;input:focus{outline:none;border-color:#16883f;box-shadow:0 0 0 3px rgba(22,136,63,.12);}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button{width:100%;margin-top:16px;padding:12px;border:0;border-radius:7px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;background:#16883f;color:white;font-size:15px;font-weight:bold;cursor:pointer;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button:hover{background:#116d33;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button:disabled{background:#9aa3ad;cursor:not-allowed;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.status{display:none;margin-top:20px;padding:13px;border-radius:7px;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;font-size:14px;line-height:1.5;white-space:pre-wrap;word-break:break-word;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.status.info{display:block;background:#eaf3ff;color:#174a7e;border:1px solid #bdd8f4;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.status.success{display:block;background:#e8f7ed;color:#176934;border:1px solid #afd8bc;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.status.error{display:block;background:#fdecec;color:#8a2020;border:1px solid #edb7b7;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.status.warning{display:block;background:#fff6df;color:#775616;border:1px solid #eed48d;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;.details{display:none;margin-top:12px;padding:12px;background:#f7f8fa;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;border:1px solid #dfe3e8;border-radius:7px;font-size:12px;white-space:pre-wrap;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;word-break:break-word;max-height:230px;overflow:auto;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/style>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/head>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;body>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;div class='card'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;h2>Solicitud de enmascaramiento&lt;/h2>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;p class='description'>Ingrese el RUT del cliente. La solicitud será enviada al &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;orquestador y se consultará automáticamente el estado de ejecución.&lt;/p>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;form id='maskForm'>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;label for='rut'>RUT del cliente&lt;/label>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;input id='rut' name='rut' type='text' maxlength='12' &quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;placeholder='90000001-1' autocomplete='off' required>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;button id='submitButton' type='submit'>Enmascarar datos&lt;/button>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/form>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;div id='statusBox' class='status'>&lt;/div>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;pre id='detailsBox' class='details'>&lt;/pre>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/div>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;script>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const form=document.getElementById('maskForm');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const rutInput=document.getElementById('rut');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const button=document.getElementById('submitButton');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const statusBox=document.getElementById('statusBox');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const detailsBox=document.getElementById('detailsBox');&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;function showStatus(message,type,data){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;statusBox.className='status '+type;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;statusBox.textContent=message;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(data){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;detailsBox.style.display='block';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;detailsBox.textContent=JSON.stringify(data,null,2);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}else{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;detailsBox.style.display='none';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;detailsBox.textContent='';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;function sleep(milliseconds){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return new Promise(function(resolve){setTimeout(resolve,milliseconds);});&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;async function consultStatus(executionId){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;for(let attempt=1;attempt&lt;=120;attempt++){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const response=await fetch('./status/'+encodeURIComponent(executionId),{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;method:'GET',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;headers:{'Accept':'application/json'},&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;cache:'no-store'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;let data;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;try{data=await response.json();}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;catch(error){throw new Error('La respuesta de estado no contiene JSON válido');}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const status=data.status||'UNKNOWN';&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(status==='SUCCESS'){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Proceso finalizado correctamente.','success',data);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return data;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(status==='FAILED'||status==='TERMINATED'||status==='NOT_FOUND'){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(data.message||'La ejecución no finalizó correctamente.','error',data);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return data;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Ejecución en curso: '+status+'\\nConsulta '+attempt+' de 120.',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'info',data);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;await sleep(2000);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error('Se agotó el tiempo de consulta. Puede verificar nuevamente el estado.');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;form.addEventListener('submit',async function(event){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;event.preventDefault();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const rut=rutInput.value.trim().toUpperCase();&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(rut.length===0){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Debe ingresar un RUT.','error');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;return;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.disabled=true;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.textContent='Enviando solicitud...';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus('Enviando solicitud al orquestador...','info');&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;try{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;const response=await fetch('./mask',{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;method:'POST',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;headers:{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'Content-Type':'application/json',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'Accept':'application/json'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;},&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;body:JSON.stringify({&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;rut:rut,&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;action:'MASK',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;requestedBy:'TDC_UI',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;sourceObject:'raw.customer'&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;})&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;let data;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;try{data=await response.json();}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;catch(error){throw new Error('La respuesta de envío no contiene JSON válido');}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!response.ok||data.accepted!==true){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error(data.message||'La solicitud fue rechazada por el orquestador');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;if(!data.executionId){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;throw new Error('Talend Cloud no devolvió un executionId');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'Solicitud aceptada.\\nExecution ID: '+data.executionId+'\\nConsultando estado...',&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;'info',data);&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;await consultStatus(data.executionId);&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}catch(error){&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;showStatus(error.message||'Ocurrió un error inesperado.','error');&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}finally{&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.disabled=false;&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;button.textContent='Enmascarar datos';&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;});&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/script>&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/body>&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;+ &quot;&lt;/html>&quot; " type="id_String" nullable="true"/>
      </outputTables>
